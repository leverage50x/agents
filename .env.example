# Stage 2A template only. Prefer manage init/enroll for private generated files.
# Never commit a real secret. Operator and agent credentials must differ.
LEVERAGE_OPERATOR_TOKEN=REPLACE_WITH_OPERATOR_RANDOM_SECRET
LEVERAGE_CREDENTIAL_STORE=.local-run/agents.json
LEVERAGE_AGENT_ID=REPLACE_WITH_ENROLLED_UUID
LEVERAGE_AGENT_TOKEN=REPLACE_WITH_AGENT_RANDOM_SECRET
LEVERAGE_HOST=127.0.0.1
LEVERAGE_PORT=8765
# Agent on your own device (inventory only; local READ-ONLY requires separate configuration):
LEVERAGE_URL=http://127.0.0.1:8765
LEVERAGE_DEVICE=laptop-1
LEVERAGE_WORKSPACE=/absolute/path/to/your-personal-git-repository
# Optional location of your Codex config/session filenames:
# LEVERAGE_CODEX_HOME=/absolute/path/to/.codex
LEVERAGE_SESSION_SOURCE=app-server
# Remote Codex execution is hard-blocked in v0.1.1, even if explicitly enabled.
# LEVERAGE_ENABLE_LIVE_CODEX=1
